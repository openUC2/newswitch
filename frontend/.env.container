# Used by the container image build (`vite build --mode container`, see ../Dockerfile).
# Overrides .env.
#
# The backend serves this bundle itself, under /newswitch/ on its own port
# (backend/newswitch/routes/http/frontend.py). Empty URLs make the frontend talk to the
# page's own origin (src/lib/backendUrls.ts), so the image works under any host name or IP.
VITE_BACKEND_URL=
VITE_WEBSOCKET_URL=

# The schema URLs for the codegen stay those of .env: no backend runs during the image
# build, so the codegen plugin falls back to the committed generated files (as in CI).
