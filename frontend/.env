# Defaults for local, non-Docker development (`just dev`).
#
# ${BACKEND_PORT:-8099} keeps ONE port definition: `just` / `docker compose` export the
# root .env into the environment, and an exported value wins over the default here.
# A bare `cd frontend && yarn dev` (no root .env in the environment) still works off the
# fallbacks. Override URLs personally with an untracked frontend/.env.local - e.g.
#   VITE_BACKEND_URL=http://jhnnsrs-lab:8099
FRONTEND_PORT=${FRONTEND_PORT:-5173}

VITE_BACKEND_URL=http://localhost:${BACKEND_PORT:-8099}
VITE_WEBSOCKET_URL=ws://localhost:${BACKEND_PORT:-8099}/ws
VITE_SCHEMA_IMPLEMENTATION_URL=http://localhost:${BACKEND_PORT:-8099}/schemas/implementations
VITE_SCHEMA_STATES_URL=http://localhost:${BACKEND_PORT:-8099}/schemas/states
VITE_SCHEMA_LOCKS_URL=http://localhost:${BACKEND_PORT:-8099}/schemas/locks
