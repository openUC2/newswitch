# Used by docker-compose (`vite --mode docker`). Overrides .env AND .env.local.
#
# ${BACKEND_PORT:-8099} / ${FRONTEND_PORT:-5173} are expanded against the container
# environment, which compose fills from the root .env - so the ports stay defined once.

FRONTEND_PORT=${FRONTEND_PORT:-5173}

# Browser-facing (host -> published port). Baked into the client JS.
VITE_BACKEND_URL=http://localhost:${BACKEND_PORT:-8099}
VITE_WEBSOCKET_URL=ws://localhost:${BACKEND_PORT:-8099}/ws

# The codegen needs no backend: it reads the committed schema export (frontend/schemas/).
