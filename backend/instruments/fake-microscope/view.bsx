<Blok kind="agent" context="panel" catalog="newswitch">
<div className="flex h-full w-full gap-3 overflow-hidden bg-gradient-to-br from-warning/10 via-transparent to-transparent p-3">
<ScrollArea className="h-full w-[400px] shrink-0">
<div className="flex flex-col gap-3 pb-3 pr-3">
<div className="flex flex-col px-1 pt-1">
    <span className="text-[10px] font-medium uppercase tracking-[0.3em] text-warning">Prediction against measurement</span>
    <span className="text-xl font-semibold tracking-tight">Calibration bench</span>
</div>
<div className="flex flex-wrap gap-1.5">
<if when={list.contains(value: list.pluck(value: obj.values(value: self.SourceState.sources), key: "on"), item: true)}>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-info">
        <span className="size-1.5 rounded-full bg-info" />
        <span>Lit</span>
    </div>
<else>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-muted-foreground">
        <span className="size-1.5 rounded-full bg-muted-foreground/30" />
        <span>Dark</span>
    </div>
</else>
</if>
<if when={self.DetectorState.is_acquiring}>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-destructive">
        <span className="size-1.5 rounded-full animate-pulse bg-destructive" />
        <span>Live</span>
    </div>
<else>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-muted-foreground">
        <span className="size-1.5 rounded-full bg-muted-foreground/30" />
        <span>Idle</span>
    </div>
</else>
</if>
<if when={list.contains(value: list.pluck(value: obj.values(value: self.OpticsState.detectors), key: "calibrated"), item: true)}>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-success">
        <span className="size-1.5 rounded-full bg-success" />
        <span>Calibrated</span>
    </div>
<else>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-muted-foreground">
        <span className="size-1.5 rounded-full bg-muted-foreground/30" />
        <span>Uncalibrated</span>
    </div>
</else>
</if>
</div>
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Measured or only predicted</span>
    <div className="mt-2">
<foreach items={obj.values(value: self.OpticsState.detectors)} let="found" key={found.name}>
    <div className="flex items-center justify-between gap-3 border-b border-border/40 py-2 last:border-0">
        <div className="flex min-w-0 flex-col">
            <span className="truncate text-sm font-medium">{found.name}</span>
            <span className="text-[11px] tabular-nums text-muted-foreground">{fmt.number(value: found.pixel_um, digits: 3)} µm a pixel</span>
        </div>
        <span className={found.calibrated ? "rounded-full bg-success/15 px-2.5 py-1 text-[11px] font-medium text-success" : "rounded-full bg-warning/15 px-2.5 py-1 text-[11px] font-medium text-warning"}>{found.calibrated ? "Measured" : "Predicted"}</span>
    </div>
</foreach>
    </div>
    <span className="mt-2 block text-[11px] text-muted-foreground">This microscope is not quite what its description says, as a real one never is. Calibrating measures the difference, separately under each objective.</span>
</div>
<SwapsControl />
<SourceControl />
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Stage z</span>
    <div className="flex items-baseline gap-1.5">
        <span className="text-3xl font-semibold tabular-nums tracking-tight">{fmt.number(value: self.MoveState.moves.stage.z.current, digits: 1)}</span>
        <span className="text-sm text-muted-foreground">µm</span>
    </div>
    <Slider className="mt-3 past:hidden [&amp;_[data-slot=slider-range]]:bg-spectrum-green [&amp;_[data-slot=slider-thumb]]:border-spectrum-green" step={10} value={self.MoveState.moves.stage.z.current} min={-500} max={500} onCommit={self.move_one(name: "stage.z", to: event.value)} />
    <div className="mt-3 grid grid-cols-5 gap-1.5 past:hidden">
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: -100.0)}>-100</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: -10.0)}>-10</Button>
        <Button size="sm" variant="secondary" onClick={self.move_one(name: "stage.z", to: 0.0)}>0</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: 10.0)}>+10</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: 100.0)}>+100</Button>
    </div>
    <span className="mt-2 block text-[11px] text-muted-foreground">Moves the sample for both arms.</span>
</div>
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Tube lens of camera_a</span>
    <div className="flex items-baseline gap-1.5">
        <span className="text-3xl font-semibold tabular-nums tracking-tight">{fmt.number(value: self.MoveState.moves.tube_a.dz.current, digits: 1)}</span>
        <span className="text-sm text-muted-foreground">µm</span>
    </div>
    <Slider className="mt-3 past:hidden [&amp;_[data-slot=slider-range]]:bg-warning [&amp;_[data-slot=slider-thumb]]:border-warning" step={100} value={self.MoveState.moves.tube_a.dz.current} min={-5000} max={5000} onCommit={self.move_one(name: "tube_a.dz", to: event.value)} />
    <div className="mt-3 grid grid-cols-5 gap-1.5 past:hidden">
        <Button size="sm" variant="outline" onClick={self.move_one(name: "tube_a.dz", by: -1000.0)}>-1000</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "tube_a.dz", by: -100.0)}>-100</Button>
        <Button size="sm" variant="secondary" onClick={self.move_one(name: "tube_a.dz", to: 0.0)}>0</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "tube_a.dz", by: 100.0)}>+100</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "tube_a.dz", by: 1000.0)}>+1000</Button>
    </div>
    <span className="mt-2 block text-[11px] text-muted-foreground">Only that arm: it blurs and rescales the image, so calibrating must be redone.</span>
</div>
<foreach items={self.DetectorState.detectors} let="camera" key={camera.name}>
    <div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
        <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">{camera.name}</span>
        <div className="mt-3 grid grid-cols-2 gap-3 past:hidden">
            <foreach items={obj.values(value: obj.get(value: self.TuneState.tunes, key: camera.name))} let="tune" key={tune.name}>
                <div className="flex min-w-0 flex-col gap-2 rounded-xl bg-muted/30 p-3">
                    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">{str.replace(value: tune.name, search: str.concat(values: [camera.name, "."]), replacement: "")}</span>
                    <div className="flex items-baseline gap-1">
                        <span className="text-xl font-semibold tabular-nums">{fmt.number(value: tune.current, digits: 1)}</span>
                        <span className="text-xs text-muted-foreground">{tune.unit}</span>
                    </div>
                    <Slider className="min-w-0" step={tune.step} value={tune.current} min={tune.minimum} max={tune.maximum} onCommit={self.tune(name: tune.name, to: event.value)} />
                </div>
            </foreach>
        </div>
        <span className="mt-2 block text-[11px] text-muted-foreground">Longer and brighter collects more photons, and bleaches more.</span>
    </div>
</foreach>
</div>
</ScrollArea>
<div className="relative flex min-w-0 flex-1 gap-3">
<div className="relative min-h-0 min-w-0 flex-1 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
    <div className="h-full past:opacity-40">
        <LiveView className="h-full" detector="camera_a" />
    </div>
    <div className="pointer-events-none absolute right-3 top-12 flex flex-col items-end gap-1 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur">
        <span className="text-sm font-medium">camera_a</span>
    </div>
</div>
<div className="relative min-h-0 min-w-0 flex-1 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
    <div className="h-full past:opacity-40">
        <LiveView className="h-full" detector="camera_b" />
    </div>
    <div className="pointer-events-none absolute right-3 top-12 flex flex-col items-end gap-1 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur">
        <span className="text-sm font-medium">camera_b</span>
    </div>
</div>
<div className="absolute bottom-4 right-4 z-10">
<div className="flex gap-1 rounded-full border border-border/60 bg-card/80 p-1 backdrop-blur past:hidden">
    <Button icon="play" size="sm" variant="ghost" className="rounded-full" onClick={self.start_live_view()}>Live</Button>
    <Button icon="square" size="sm" variant="ghost" className="rounded-full" onClick={self.stop_live_view()}>Stop</Button>
    <Button icon="camera" size="sm" variant="ghost" className="rounded-full" onClick={self.capture_image()}>Snap</Button>
    <Button icon="wand" size="sm" variant="ghost" className="rounded-full" onClick={self.calibrate_light_path()}>Calibrate</Button>
</div>
</div>
</div>
</div>
</Blok>
