<Blok kind="agent" context="panel" catalog="newswitch">
<div className="flex h-full w-full gap-3 overflow-hidden bg-gradient-to-br from-spectrum-violet/10 via-transparent to-transparent p-3">
<ScrollArea className="h-full w-[400px] shrink-0">
<div className="flex flex-col gap-3 pb-3 pr-3">
<div className="flex flex-col px-1 pt-1">
    <span className="text-[10px] font-medium uppercase tracking-[0.3em] text-spectrum-violet">Brightfield</span>
    <span className="text-xl font-semibold tracking-tight">H&amp;E slide</span>
</div>
<div className="flex flex-wrap gap-1.5">
<if when={self.DetectorState.is_acquiring}>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-destructive">
        <span className="size-1.5 rounded-full animate-pulse bg-destructive" />
        <span>Live</span>
    </div>
<else>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-muted-foreground">
        <span className="size-1.5 rounded-full bg-muted-foreground/30" />
        <span>Idle</span>
    </div>
</else>
</if>
<if when={list.contains(value: list.pluck(value: obj.values(value: self.OpticsState.detectors), key: "calibrated"), item: true)}>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-success">
        <span className="size-1.5 rounded-full bg-success" />
        <span>Calibrated</span>
    </div>
<else>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-muted-foreground">
        <span className="size-1.5 rounded-full bg-muted-foreground/30" />
        <span>Uncalibrated</span>
    </div>
</else>
</if>
</div>
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">On the slide</span>
    <div className="mt-2">
<div className="flex items-center gap-2">
    <span className="size-3 shrink-0 rounded-full bg-spectrum-violet" />
    <span className="text-sm font-medium">Hematoxylin</span>
    <span className="truncate text-[11px] text-muted-foreground">nuclei, blue-purple</span>
</div>
<div className="flex items-center gap-2">
    <span className="size-3 shrink-0 rounded-full bg-spectrum-red" />
    <span className="text-sm font-medium">Eosin</span>
    <span className="truncate text-[11px] text-muted-foreground">around them, pink</span>
</div>
    </div>
    <span className="mt-2 block text-[11px] text-muted-foreground">Nothing fluoresces: what you see is what the stains take out of white light. Live shows brightness; an acquisition keeps red, green and blue as channels.</span>
</div>
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Beside the slide</span>
    <div className="flex items-baseline gap-1.5">
        <span className="text-3xl font-semibold tabular-nums tracking-tight">{logic.any(values: [fmt.number(value: list.first(value: list.compact(value: list.pluck(value: self.DetectorState.detectors, key: "reading"))), digits: 2), "—"])}</span>
        <span className="text-sm text-muted-foreground">°C</span>
    </div>
    <span className="mt-1 block text-[11px] text-muted-foreground">The thermometer on the stage insert, {fmt.number(value: math.div(a: self.SpaceState.points.thermometer.x, b: 1000), digits: 0)} mm along x from the section: read once a second while live.</span>
</div>
<SwapsControl />
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Focus</span>
    <div className="flex items-baseline gap-1.5">
        <span className="text-3xl font-semibold tabular-nums tracking-tight">{fmt.number(value: self.MoveState.moves.stage.z.current, digits: 1)}</span>
        <span className="text-sm text-muted-foreground">µm</span>
    </div>
    <Slider className="mt-3 past:hidden [&amp;_[data-slot=slider-range]]:bg-spectrum-violet [&amp;_[data-slot=slider-thumb]]:border-spectrum-violet" step={1} value={self.MoveState.moves.stage.z.current} min={-50} max={50} onCommit={self.move_one(name: "stage.z", to: event.value)} />
    <div className="mt-3 grid grid-cols-5 gap-1.5 past:hidden">
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: -10.0)}>-10</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: -1.0)}>-1</Button>
        <Button size="sm" variant="secondary" onClick={self.move_one(name: "stage.z", to: 0.0)}>0</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: 1.0)}>+1</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.z", by: 10.0)}>+10</Button>
    </div>
    <span className="mt-2 block text-[11px] text-muted-foreground">A section is thin, so it leaves focus as a whole: past its depth, everything blurs.</span>
</div>
<MoveControl className="locked:opacity-60" />
<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Under this objective</span>
    <div className="mt-2">
<div className="grid grid-cols-3 divide-x divide-border/50 rounded-xl bg-muted/30">
<div className="flex min-w-0 flex-col px-3 py-2">
    <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Pixel</span>
    <span className="truncate text-lg font-semibold tabular-nums ">{fmt.number(value: self.OpticsState.detectors.camera.pixel_um, digits: 2)} <span className="text-xs font-normal text-muted-foreground">µm</span></span>
</div>
<div className="flex min-w-0 flex-col px-3 py-2">
    <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Field</span>
    <span className="truncate text-lg font-semibold tabular-nums ">{fmt.number(value: self.OpticsState.detectors.camera.field_width_um, digits: 0)} <span className="text-xs font-normal text-muted-foreground">µm</span></span>
</div>
<div className="flex min-w-0 flex-col px-3 py-2">
    <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Depth</span>
    <span className="truncate text-lg font-semibold tabular-nums ">{fmt.number(value: self.OpticsState.detectors.camera.depth_of_field_um, digits: 1)} <span className="text-xs font-normal text-muted-foreground">µm</span></span>
</div>
</div>
    </div>
</div>
<SourceControl />
<foreach items={self.DetectorState.detectors} let="camera" key={camera.name}>
    <div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
        <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">{camera.name}</span>
        <div className="mt-3 grid grid-cols-2 gap-3 past:hidden">
            <foreach items={obj.values(value: obj.get(value: self.TuneState.tunes, key: camera.name))} let="tune" key={tune.name}>
                <div className="flex min-w-0 flex-col gap-2 rounded-xl bg-muted/30 p-3">
                    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">{str.replace(value: tune.name, search: str.concat(values: [camera.name, "."]), replacement: "")}</span>
                    <div className="flex items-baseline gap-1">
                        <span className="text-xl font-semibold tabular-nums">{fmt.number(value: tune.current, digits: 1)}</span>
                        <span className="text-xs text-muted-foreground">{tune.unit}</span>
                    </div>
                    <Slider className="min-w-0" step={tune.step} value={tune.current} min={tune.minimum} max={tune.maximum} onCommit={self.tune(name: tune.name, to: event.value)} />
                </div>
            </foreach>
        </div>
        <span className="mt-2 block text-[11px] text-muted-foreground">Longer collects more light. There is no bleaching to worry about here.</span>
    </div>
</foreach>
</div>
</ScrollArea>
<div className="relative flex min-w-0 flex-1 gap-3">
<div className="relative min-h-0 min-w-0 flex-1 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
    <div className="h-full past:opacity-40">
        <LiveView className="h-full" />
    </div>
    <div className="pointer-events-none absolute right-3 top-12 flex flex-col items-end gap-1 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur">
        <span className="text-sm font-medium">{fmt.number(value: self.OpticsState.detectors.camera.field_width_um, digits: 0)} µm across</span>
    </div>
</div>
<div className="absolute bottom-4 right-4 z-10">
<div className="flex gap-1 rounded-full border border-border/60 bg-card/80 p-1 backdrop-blur past:hidden">
    <Button icon="play" size="sm" variant="ghost" className="rounded-full" onClick={self.start_live_view()}>Live</Button>
    <Button icon="square" size="sm" variant="ghost" className="rounded-full" onClick={self.stop_live_view()}>Stop</Button>
    <Button icon="camera" size="sm" variant="ghost" className="rounded-full" onClick={self.capture_image()}>Snap</Button>
    <Button icon="wand" size="sm" variant="ghost" className="rounded-full" onClick={self.calibrate_light_path()}>Calibrate</Button>
</div>
</div>
</div>
</div>
</Blok>
