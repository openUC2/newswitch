<Blok kind="agent" context="panel">
<local name="picked" default={[]} />
<local name="z_range" kind="STRING" default="0" persist />
<local name="z_step" kind="STRING" default="2" persist />
<local name="columns" kind="STRING" default="1" persist />
<local name="rows" kind="STRING" default="1" persist />
<local name="overlap" default={0.1} persist />
<local name="times" kind="STRING" default="1" persist />
<local name="every_s" kind="STRING" default="0" persist />
<local name="name" kind="STRING" default="mda" persist />
<foreach items={list.compact(value: [{
    planes: val.to_number(value: z_range) > 0 && val.to_number(value: z_step) > 0
        ? math.max(values: [2, math.add(a: math.round(value: math.div(a: val.to_number(value: z_range), b: val.to_number(value: z_step))), b: 1)])
        : 1,
    tiles: math.mul(a: math.max(values: [1, val.to_number(value: columns)]), b: math.max(values: [1, val.to_number(value: rows)])),
    repeats: math.max(values: [1, val.to_number(value: times)]),
    run: self.tasks.acquire_mda
}])} let="mda" key={"mda"}>
<div className="flex flex-col gap-3 p-3">

    <!-- channels -->
    <Card className="gap-2 py-3">
        <div className="flex items-center gap-2 px-4">
            <Icon name="layers" size={16} className="text-primary" />
            <Text size="sm" weight="semibold" className="flex-1">Channels</Text>
            <Badge variant="secondary">{str.concat(values: [list.len(value: picked), " picked"])}</Badge>
        </div>
        <if when={list.len(value: self.OpticsState.channels) > 0}>
            <ToggleGroup multiple bind={picked} variant="outline" size="sm" className="flex flex-wrap justify-start gap-1 px-4">
                <foreach items={self.OpticsState.channels} let="channel" key={channel.name}>
                    <ToggleGroupItem value={channel.name}>{channel.name}</ToggleGroupItem>
                </foreach>
            </ToggleGroup>
            <Text size="xs" tone="muted" className="px-4">Each at the brightness its light has now (its preset when it is off) and the exposure its camera has now.</Text>
        <else>
            <Text size="sm" tone="muted" className="px-4">No light reaches a camera: there is nothing to image.</Text>
        </else>
        </if>
    </Card>

    <div className="flex flex-col gap-3 lg:flex-row">
        <!-- stack -->
        <Card className="min-w-0 flex-1 gap-2 py-3">
            <div className="flex items-center gap-2 px-4">
                <Icon name="layers" size={16} className="text-primary" />
                <Text size="sm" weight="semibold" className="flex-1">Stack</Text>
                <Text size="xs" tone="muted" mono>{str.concat(values: [mda.planes, mda.planes == 1 ? " plane" : " planes"])}</Text>
            </div>
            <Grid columns={2} gap="0.5rem" padding="0 1rem">
                <Field label="Range (µm)"><Input type="number" bind={z_range} /></Field>
                <Field label="Step (µm)"><Input type="number" bind={z_step} /></Field>
            </Grid>
            <Text size="xs" tone="muted" className="px-4">Centred where the focus is; 0: one plane, there.</Text>
        </Card>

        <!-- tiles -->
        <Card className="min-w-0 flex-1 gap-2 py-3">
            <div className="flex items-center gap-2 px-4">
                <Icon name="grid" size={16} className="text-primary" />
                <Text size="sm" weight="semibold" className="flex-1">Tiles</Text>
                <Text size="xs" tone="muted" mono>{str.concat(values: [mda.tiles, mda.tiles == 1 ? " tile" : " tiles"])}</Text>
            </div>
            <Grid columns={2} gap="0.5rem" padding="0 1rem">
                <Field label="Columns"><Input type="number" bind={columns} /></Field>
                <Field label="Rows"><Input type="number" bind={rows} /></Field>
            </Grid>
            <div className="flex items-center gap-2 px-4">
                <Text size="xs" tone="muted" className="w-14">Overlap</Text>
                <Slider className="flex-1" bind={overlap} min={0} max={0.5} step={0.05} disabled={mda.tiles == 1} />
                <Text size="xs" mono className="w-10 text-right">{fmt.percent(value: overlap, digits: 0)}</Text>
            </div>
        </Card>

        <!-- time-lapse -->
        <Card className="min-w-0 flex-1 gap-2 py-3">
            <div className="flex items-center gap-2 px-4">
                <Icon name="clock" size={16} className="text-primary" />
                <Text size="sm" weight="semibold" className="flex-1">Time-lapse</Text>
                <Text size="xs" tone="muted" mono>{str.concat(values: [mda.repeats, mda.repeats == 1 ? " time" : " times"])}</Text>
            </div>
            <Grid columns={2} gap="0.5rem" padding="0 1rem">
                <Field label="Times"><Input type="number" bind={times} /></Field>
                <Field label="Every (s)"><Input type="number" bind={every_s} disabled={mda.repeats == 1} /></Field>
            </Grid>
            <Text size="xs" tone="muted" className="px-4">From the start of one time to the next; 0: right after it.</Text>
        </Card>
    </div>

    <!-- run -->
    <Card className="gap-3 py-3">
        <div className="flex flex-wrap items-end gap-3 px-4">
            <Field label="Name" className="min-w-40 flex-1"><Input bind={name} /></Field>
            <Text size="sm" tone="muted" mono>{str.concat(values: [list.len(value: picked), " × ", mda.planes, " × ", mda.tiles, " × ", mda.repeats, " = ", math.mul(a: math.mul(a: list.len(value: picked), b: mda.planes), b: math.mul(a: mda.tiles, b: mda.repeats)), " images"])}</Text>
            <Button icon="play" disabled={list.len(value: picked) == 0 || mda.run.running} onClick={self.acquire_mda(
                channels: picked,
                z_range_um: val.to_number(value: z_range),
                z_step_um: val.to_number(value: z_step),
                columns: val.to_number(value: columns),
                rows: val.to_number(value: rows),
                overlap: overlap,
                times: val.to_number(value: times),
                every_s: val.to_number(value: every_s),
                name: name
            )}>Acquire</Button>
        </div>

        <if when={mda.run.running}>
            <div className="flex flex-col gap-1 px-4">
                <Progress value={mda.run.progress} max={100} />
                <Text size="xs" tone="muted">{mda.run.message ?? "Starting"}</Text>
            </div>
        </if>
        <if when={mda.run.failed}>
            <Alert variant="destructive" icon="alert-triangle" title="The acquisition failed" className="mx-4" description={mda.run.error ?? ""} />
        </if>
        <if when={mda.run.done}>
            <div className="flex flex-col gap-1 px-4">
                <Text size="xs" tone="muted">{mda.run.message ?? "Done"}</Text>
                <foreach items={mda.run.returns.datasets ?? []} let="dataset" key={dataset.id}>
                    <div className="flex items-center gap-2">
                        <Icon name="database" size={14} className="text-muted-foreground" />
                        <Text size="sm" truncate className="flex-1">{dataset.name}</Text>
                        <Text size="xs" tone="muted" mono>{dataset.detector}</Text>
                    </div>
                </foreach>
            </div>
        </if>
    </Card>
</div>
</foreach>
</Blok>
