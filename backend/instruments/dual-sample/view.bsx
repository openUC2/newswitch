<Blok kind="agent" context="panel" catalog="newswitch">
<div className="flex h-full w-full gap-3 overflow-hidden bg-gradient-to-br from-spectrum-cyan/10 via-transparent to-spectrum-violet/10 p-3">
<ScrollArea className="h-full w-[400px] shrink-0">
<div className="flex flex-col gap-3 pb-3 pr-3">
<div className="flex flex-col px-1 pt-1">
    <span className="text-[10px] font-medium uppercase tracking-[0.3em] text-muted-foreground">Two samples</span>
    <span className="text-xl font-semibold tracking-tight">Each on its own stage</span>
    <span className="mt-1 text-[11px] text-muted-foreground">Two light paths in one instrument: what one stage does, only its own camera sees. The stage view shows one sample at a time; pick which at its top.</span>
</div>
<div className="flex flex-wrap gap-1.5">
<if when={self.detector.is_acquiring}>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-destructive">
        <span className="size-1.5 rounded-full animate-pulse bg-destructive" />
        <span>Live</span>
    </div>
<else>
    <div className="flex items-center gap-1.5 rounded-full border border-border/60 bg-card/70 px-2.5 py-1 text-[11px] text-muted-foreground">
        <span className="size-1.5 rounded-full bg-muted-foreground/30" />
        <span>Idle</span>
    </div>
</else>
</if>
</div>

<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <div className="flex items-center gap-2">
        <span className="size-3 shrink-0 rounded-full bg-spectrum-cyan" />
        <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Sample a · stage_a</span>
    </div>
    <span className="mt-1 block text-sm font-medium">GFP beads, by fluorescence</span>
    <span className="block text-[11px] text-muted-foreground">laser_488, seen by cam_a</span>
    <div className="mt-3 flex items-baseline gap-1.5">
        <span className="text-[10px] uppercase tracking-wider text-muted-foreground">focus</span>
        <span className="text-2xl font-semibold tabular-nums tracking-tight">{fmt.number(value: self.move.moves.stage_a.z.current, digits: 1)}</span>
        <span className="text-sm text-muted-foreground">µm</span>
    </div>
    <Slider className="mt-2 past:hidden" step={1} value={self.move.moves.stage_a.z.current} min={-50} max={50} onCommit={self.move_one(name: "stage_a.z", to: event.value)} />
    <div className="mt-3 grid grid-cols-4 gap-1.5 past:hidden">
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_a.x", by: -100.0)}>x −</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_a.x", by: 100.0)}>x +</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_a.y", by: -100.0)}>y −</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_a.y", by: 100.0)}>y +</Button>
    </div>
    <div className="mt-3 grid grid-cols-3 divide-x divide-border/50 rounded-xl bg-muted/30">
        <div className="flex min-w-0 flex-col px-3 py-2">
            <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">x, y</span>
            <span className="truncate text-sm font-semibold tabular-nums">{fmt.number(value: self.move.moves.stage_a.x.current, digits: 0)}, {fmt.number(value: self.move.moves.stage_a.y.current, digits: 0)}</span>
        </div>
        <div className="flex min-w-0 flex-col px-3 py-2">
            <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Pixel</span>
            <span className="truncate text-sm font-semibold tabular-nums">{fmt.number(value: self.optics.detectors.cam_a.pixel_um, digits: 2)} µm</span>
        </div>
        <div className="flex min-w-0 flex-col px-3 py-2">
            <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Field</span>
            <span className="truncate text-sm font-semibold tabular-nums">{fmt.number(value: self.optics.detectors.cam_a.field_width_um, digits: 0)} µm</span>
        </div>
    </div>
</div>

<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <div className="flex items-center gap-2">
        <span className="size-3 shrink-0 rounded-full bg-spectrum-violet" />
        <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Sample b · stage_b</span>
    </div>
    <span className="mt-1 block text-sm font-medium">An H&amp;E section, in white light</span>
    <span className="block text-[11px] text-muted-foreground">white_led through the condenser, seen by cam_b in color</span>
    <div className="mt-3 flex items-baseline gap-1.5">
        <span className="text-[10px] uppercase tracking-wider text-muted-foreground">focus</span>
        <span className="text-2xl font-semibold tabular-nums tracking-tight">{fmt.number(value: self.move.moves.stage_b.z.current, digits: 1)}</span>
        <span className="text-sm text-muted-foreground">µm</span>
    </div>
    <Slider className="mt-2 past:hidden" step={1} value={self.move.moves.stage_b.z.current} min={-50} max={50} onCommit={self.move_one(name: "stage_b.z", to: event.value)} />
    <div className="mt-3 grid grid-cols-4 gap-1.5 past:hidden">
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_b.x", by: -100.0)}>x −</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_b.x", by: 100.0)}>x +</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_b.y", by: -100.0)}>y −</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage_b.y", by: 100.0)}>y +</Button>
    </div>
    <div className="mt-3 grid grid-cols-3 divide-x divide-border/50 rounded-xl bg-muted/30">
        <div className="flex min-w-0 flex-col px-3 py-2">
            <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">x, y</span>
            <span className="truncate text-sm font-semibold tabular-nums">{fmt.number(value: self.move.moves.stage_b.x.current, digits: 0)}, {fmt.number(value: self.move.moves.stage_b.y.current, digits: 0)}</span>
        </div>
        <div className="flex min-w-0 flex-col px-3 py-2">
            <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Pixel</span>
            <span className="truncate text-sm font-semibold tabular-nums">{fmt.number(value: self.optics.detectors.cam_b.pixel_um, digits: 2)} µm</span>
        </div>
        <div className="flex min-w-0 flex-col px-3 py-2">
            <span className="truncate text-[10px] uppercase tracking-wider text-muted-foreground">Beside it</span>
            <span className="truncate text-sm font-semibold tabular-nums">{logic.any(values: [fmt.number(value: list.first(value: list.compact(value: list.pluck(value: self.detector.detectors, key: "reading"))), digits: 1), "—"])} °C</span>
        </div>
    </div>
</div>
<SourceControl />
</div>
</ScrollArea>
<div className="relative flex min-w-0 flex-1 flex-col gap-3">
<div className="grid min-h-0 flex-1 grid-cols-2 gap-3">
    <div className="relative min-h-0 min-w-0 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
        <div className="h-full past:opacity-40">
            <LiveView detector="cam_a" className="h-full" />
        </div>
        <div className="pointer-events-none absolute right-3 top-12 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur"><span className="text-sm font-medium">cam_a · sample a</span></div>
    </div>
    <div className="relative min-h-0 min-w-0 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
        <div className="h-full past:opacity-40">
            <LiveView detector="cam_b" className="h-full" />
        </div>
        <div className="pointer-events-none absolute right-3 top-12 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur"><span className="text-sm font-medium">cam_b · sample b</span></div>
    </div>
</div>
<div className="absolute bottom-4 right-4 z-10">
<div className="flex gap-1 rounded-full border border-border/60 bg-card/80 p-1 backdrop-blur past:hidden">
    <Button icon="play" size="sm" variant="ghost" className="rounded-full" onClick={self.start_live_view()}>Live</Button>
    <Button icon="square" size="sm" variant="ghost" className="rounded-full" onClick={self.stop_live_view()}>Stop</Button>
    <Button icon="camera" size="sm" variant="ghost" className="rounded-full" onClick={self.capture_image()}>Snap</Button>
    <Button icon="wand" size="sm" variant="ghost" className="rounded-full" onClick={self.calibrate_light_path()}>Calibrate</Button>
</div>
</div>
</div>
</div>
</Blok>
