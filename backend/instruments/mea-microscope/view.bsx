<Blok kind="agent" context="panel" catalog="newswitch">
<div className="flex h-full w-full gap-3 overflow-hidden bg-gradient-to-br from-spectrum-cyan/10 via-transparent to-transparent p-3">
<ScrollArea className="h-full w-[400px] shrink-0">
<div className="flex flex-col gap-3 pb-3 pr-3">
<div className="flex flex-col px-1 pt-1">
    <span className="text-[10px] font-medium uppercase tracking-[0.3em] text-muted-foreground">Electrode array</span>
    <span className="text-xl font-semibold tracking-tight">Cells on an MEA chip</span>
    <span className="mt-1 text-[11px] text-muted-foreground">The chip is what the sample is mounted on: its 8 x 8 electrodes record the voltage of the cells the camera sees. The map shows how much each electrode swung in the last 50 ms.</span>
</div>

<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Largest swing</span>
    <div className="mt-1 flex items-baseline gap-1.5">
        <span className="text-2xl font-semibold tabular-nums tracking-tight">{logic.any(values: [fmt.number(value: list.first(value: list.compact(value: list.pluck(value: self.DetectorState.detectors, key: "reading"))), digits: 0), "—"])}</span>
        <span className="text-sm text-muted-foreground">µV</span>
    </div>
</div>

<div className="rounded-2xl border border-border/60 bg-card/70 p-4 shadow-xl">
    <span className="text-[10px] font-medium uppercase tracking-[0.2em] text-muted-foreground">Focus</span>
    <div className="mt-1 flex items-baseline gap-1.5">
        <span className="text-2xl font-semibold tabular-nums tracking-tight">{fmt.number(value: self.MoveState.moves.stage.z.current, digits: 1)}</span>
        <span className="text-sm text-muted-foreground">µm</span>
    </div>
    <Slider className="mt-2 past:hidden" step={1} value={self.MoveState.moves.stage.z.current} min={-50} max={50} onCommit={self.move_one(name: "stage.z", to: event.value)} />
    <div className="mt-3 grid grid-cols-4 gap-1.5 past:hidden">
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.x", by: -200.0)}>x −</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.x", by: 200.0)}>x +</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.y", by: -200.0)}>y −</Button>
        <Button size="sm" variant="outline" onClick={self.move_one(name: "stage.y", by: 200.0)}>y +</Button>
    </div>
</div>
<SourceControl />
</div>
</ScrollArea>
<div className="relative flex min-w-0 flex-1 flex-col gap-3">
<div className="grid min-h-0 flex-1 grid-cols-2 gap-3">
    <div className="relative min-h-0 min-w-0 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
        <div className="h-full past:opacity-40">
            <LiveView detector="camera" className="h-full" />
        </div>
        <div className="pointer-events-none absolute right-3 top-12 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur"><span className="text-sm font-medium">camera</span></div>
    </div>
    <div className="relative min-h-0 min-w-0 overflow-hidden rounded-2xl border border-border/60 bg-background shadow-2xl">
        <div className="h-full past:opacity-40">
            <LiveView detector="mea" className="h-full" />
        </div>
        <div className="pointer-events-none absolute right-3 top-12 rounded-xl border border-border/60 bg-card/80 px-3 py-1.5 backdrop-blur"><span className="text-sm font-medium">mea · swing per electrode</span></div>
    </div>
</div>
<div className="absolute bottom-4 right-4 z-10">
<div className="flex gap-1 rounded-full border border-border/60 bg-card/80 p-1 backdrop-blur past:hidden">
    <Button icon="play" size="sm" variant="ghost" className="rounded-full" onClick={self.start_live_view()}>Live</Button>
    <Button icon="square" size="sm" variant="ghost" className="rounded-full" onClick={self.stop_live_view()}>Stop</Button>
    <Button icon="camera" size="sm" variant="ghost" className="rounded-full" onClick={self.capture_image()}>Snap</Button>
</div>
</div>
</div>
</div>
</Blok>
