# Settings of docker/docker-compose.yml. Copy this file to docker/.env (git-ignored) and adapt
# it; docker compose reads docker/.env automatically. All lines are optional.

# Image to run: a tag of ghcr.io/openuc2/newswitch, e.g. edge (main), sha-<commit>, pr-<number>,
# a version - or newswitch:local after `just prod-build`.
NEWSWITCH_IMAGE=ghcr.io/openuc2/newswitch:edge

# hardware (real devices) or virtual (simulated microscope)
NEWSWITCH_MODE=hardware

# Device YAML, relative to the backend folder of the image (backend/ in this repository).
# Examples: configs/machines/openuc2-first-cord-30059-mixed.yaml (the lab Pi),
# configs/camTest_hik_config.yaml (one HikRobot USB3 camera, no UC2 board),
# configs/camTest_config.yaml (one simulated camera).
NEWSWITCH_CONFIG=configs/machines/openuc2-first-cord-30059-mixed.yaml
