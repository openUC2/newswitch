# Canonical ports for the whole stack. Committed on purpose - these are defaults,
# not secrets. Read by:
#   - `just`            (set dotenv-load, exports them into every recipe)
#   - `docker compose`  (interpolation here + an `environment:` block per service)
#   - `frontend/.env*`  (`${BACKEND_PORT:-8099}` - the injected value wins over the default)
#   - the backend       (`os.environ` in newswitch.app / test.py)
#
# Override per machine WITHOUT editing this file by exporting in the shell, e.g.
#   BACKEND_PORT=9000 just dev
# A shell variable beats this file everywhere above.

# Address uvicorn binds to. 0.0.0.0 so the LAN / a container can reach it.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8069

# Vite dev server port.
FRONTEND_PORT=5473

# The mikro stack (docker compose --profile mikro, just mikro): where it is published.
MIKRO_PORT=6580
RUSTFS_PORT=6890

# FastAPI mode only talks to a mikro when told where it is. Unset: it runs without one.
# `just dev-mikro` sets these for the stack above; a backend in compose wants
# http://mikro and http://rustfs:9000 instead. Agent mode ignores them.
# MIKRO_URL=http://localhost:6580
# MIKRO_DATALAYER_URL=http://localhost:6890
# MIKRO_TOKEN=newswitch-dev
